{
  "version": 1,
  "runtime": "docker",
  "limits": {
    "timeout_seconds": 120,
    "max_output_bytes": 200000,
    "max_snapshot_files": 20000,
    "max_snapshot_bytes": 268435456,
    "memory": "1g",
    "cpus": "2",
    "pids": 128,
    "max_concurrent_tasks": 1
  },
  "default_profile": "coding",
  "profiles": {
    "python-safe": {
      "image": "REPLACE_WITH_REPOSITORY_DIGEST_OR_FULL_LOCAL_SHA256_IMAGE_ID",
      "tools": [
        "python_version",
        "run_pytest",
        "run_python_script",
        "run_ruff",
        "run_mypy",
        "run_pytest_coverage"
      ],
      "workspace_access": "read-only"
    },
    "coding": {
      "image": "REPLACE_WITH_REPOSITORY_DIGEST_OR_FULL_LOCAL_SHA256_IMAGE_ID",
      "tools": [
        "python_version",
        "run_pytest",
        "run_python_script",
        "run_ruff",
        "run_mypy",
        "run_pytest_coverage",
        "run_command",
        "start_command"
      ],
      "workspace_access": "read-only",
      "allow_arbitrary_commands": true
    }
  }
}
