{
  "version": 1,
  "runtime": "docker",
  "limits": {
    "timeout_seconds": 120,
    "max_output_bytes": 200000,
    "max_snapshot_files": 20000,
    "max_snapshot_bytes": 268435456,
    "memory": "1g",
    "cpus": "2",
    "pids": 128,
    "max_concurrent_tasks": 1,
    "max_workspace_file_bytes": 16777216,
    "max_workspace_growth_bytes": 268435456,
    "max_artifacts_per_execution": 32,
    "max_artifact_bytes": 16777216,
    "max_total_artifact_bytes": 67108864,
    "allow_best_effort_disk_limit": true
  },
  "tasks": {
    "test": {
      "mode": "run",
      "workspace_access": "read-only",
      "image": "REPLACE_WITH_REPOSITORY_DIGEST_OR_FULL_LOCAL_SHA256_IMAGE_ID",
      "argv": ["REPLACE_WITH_TEST_EXECUTABLE", "REPLACE_WITH_TEST_ARGUMENT"]
    },
    "lint": {
      "mode": "run",
      "workspace_access": "read-only",
      "image": "REPLACE_WITH_REPOSITORY_DIGEST_OR_FULL_LOCAL_SHA256_IMAGE_ID",
      "argv": ["REPLACE_WITH_LINT_EXECUTABLE", "REPLACE_WITH_LINT_ARGUMENT"]
    },
    "build": {
      "mode": "run",
      "workspace_access": "writable",
      "image": "REPLACE_WITH_REPOSITORY_DIGEST_OR_FULL_LOCAL_SHA256_IMAGE_ID",
      "argv": ["REPLACE_WITH_BUILD_EXECUTABLE", "REPLACE_WITH_BUILD_ARGUMENT"]
    },
    "dev": {
      "mode": "service",
      "workspace_access": "writable",
      "image": "REPLACE_WITH_REPOSITORY_DIGEST_OR_FULL_LOCAL_SHA256_IMAGE_ID",
      "argv": ["REPLACE_WITH_SERVICE_EXECUTABLE", "REPLACE_WITH_SERVICE_ARGUMENT"]
    }
  }
}
